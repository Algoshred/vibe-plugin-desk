{
  "name": "@vibecontrols/vibe-plugin-desk",
  "version": "2026.1125.0",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Desk meta plugin for BotManor Stewards: routes desk actions (screenshot, input, files, shell) to the registered desk provider and enforces fencing, idempotency, workspace-folder confinement, timeouts, local consent and the kill switch.",
  "engines": {
    "bun": ">=1.4.4"
  },
  "author": {
    "name": "Vignesh T.V",
    "url": "https://github.com/tvvignesh"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify-syntax --minify-whitespace --external elysia && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "type:check": "boff gate -- bun check --no-pretty",
    "clean": "rimraf dist",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run build",
    "sanity": "boff sanity",
    "test": "bun test",
    "sanity:force": "boff sanity --force",
    "audit": "bun audit --audit-level=high"
  },
  "dependencies": {
    "@vibecontrols/plugin-sdk": "2026.1125.1"
  },
  "devDependencies": {
    "@burdenoff/toolchain": "2026.1107.14",
    "@types/bun": "^1.4.4",
    "eslint": "^9.39.5",
    "knip": "^6.44.1",
    "rimraf": "^6.1.4",
    "typescript": "6.0.3",
    "elysia": "^1.4.29"
  },
  "peerDependencies": {
    "@vibecontrols/agent": ">=2026.1125.1"
  },
  "peerDependenciesMeta": {
    "@vibecontrols/agent": {
      "optional": true
    }
  },
  "keywords": [
    "vibecontrols",
    "vibe",
    "vibe-plugin",
    "desk",
    "stewards",
    "computer-use",
    "meta",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Algoshred/vibe-plugin-desk.git"
  },
  "bugs": {
    "url": "https://github.com/Algoshred/vibe-plugin-desk/issues"
  },
  "homepage": "https://github.com/Algoshred/vibe-plugin-desk#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "vibe-plugin.sig.json"
  ]
}
